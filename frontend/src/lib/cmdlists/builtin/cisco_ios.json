    {
      "id": "debug",
      "name": "Debug",
      "icon": "debug",
      "color": "#B23B3B",
      "summary": "Packet capture and debugs — stop them when done",
      "debug": true,
      "sections": [
        {
          "title": "Packet capture (EPC)",
          "items": [
            {
              "kind": "recipe",
              "name": "Capture on an interface",
              "desc": "Embedded Packet Capture \"ZAPTERM\", both directions, all IPv4, limited in time and packets",
              "fields": [
                {
                  "key": "iface",
                  "label": "Interface",
                  "placeholder": "GigabitEthernet1/0/1"
                },
                {
                  "key": "seconds",
                  "label": "Stop after (seconds)",
                  "default": "60"
                }
              ],
              "lines": [
                "monitor capture ZAPTERM interface {{iface}} both",
                "monitor capture ZAPTERM match ipv4 any any",
                "monitor capture ZAPTERM limit duration {{seconds}} packets 1000",
                "monitor capture ZAPTERM start"
              ],
              "caution": "Cisco: Embedded Packet Capture “consumes CPU and memory resources”. This capture stops by itself after the seconds you set or 1000 packets; stop and delete it when done."
            },
            {
              "kind": "command",
              "cmd": "monitor capture ZAPTERM stop",
              "desc": "Stop the capture"
            },
            {
              "kind": "command",
              "cmd": "show monitor capture ZAPTERM buffer dump",
              "desc": "Show the captured packets"
            },
            {
              "kind": "command",
              "cmd": "monitor capture ZAPTERM export <location>",
              "desc": "Export the capture as a PCAP file"
            },
            {
              "kind": "command",
              "cmd": "no monitor capture ZAPTERM",
              "desc": "Delete the capture"
            }
          ]
        },
        {
          "title": "Debugs",
          "items": [
            {
              "kind": "recipe",
              "name": "Crypto debug of a peer",
              "desc": "IKE and IPsec debugs limited to one peer (conditional debug)",
              "fields": [
                {
                  "key": "peer",
                  "label": "Peer IP",
                  "placeholder": "203.0.113.2"
                }
              ],
              "lines": [
                "terminal monitor",
                "debug crypto condition peer ipv4 {{peer}}",
                "debug crypto isakmp",
                "debug crypto ipsec"
              ],
              "caution": "Cisco: “Enabling debugging can disrupt router operation, especially when the network is under heavy load.” Check show processes cpu first, never debug to the console, and press Stop debug (undebug all) when done."
            },
            {
              "kind": "recipe",
              "name": "BGP updates of a peer",
              "desc": "BGP update messages exchanged with one neighbor",
              "fields": [
                {
                  "key": "peer",
                  "label": "Neighbor IP",
                  "placeholder": "192.0.2.1"
                }
              ],
              "lines": ["terminal monitor", "debug ip bgp {{peer}} updates"],
              "caution": "Cisco: “Enabling debugging can disrupt router operation, especially when the network is under heavy load.” Check show processes cpu first, never debug to the console, and press Stop debug (undebug all) when done."
            },
            {
              "kind": "command",
              "cmd": "terminal monitor",
              "desc": "Show debug output in this (SSH/Telnet) session"
            },
            {
              "kind": "command",
              "cmd": "terminal no monitor",
              "desc": "Stop showing debug output here (debugs keep running)"
            }
          ]
        }
      ]
