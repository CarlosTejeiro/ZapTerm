{
  "format": "zapterm-command-lists",
  "version": 1,
  "platform": "macos",
  "notes": "macOS command lists, shown for local tabs when ZapTerm runs on a Mac (zsh, the default shell, or bash). Every command and option below was checked against the man page in Apple's open-source releases (github.com/apple-oss-distributions) — nothing was added from memory: uname(1), hostinfo(8), uptime(1), scutil(8), sysctl(8), vm_stat(1), df(1), du(1), iostat(8), dmesg(8), who(1), w(1), last(1), ps(1), top(1), kill(1), killall(1), launchctl(1), ifconfig(8), netstat(1), arp(8), ndp(8), lsof(8), route(8), ping(8), traceroute(8), dns-sd(1), pmset(1), caffeinate(8), tcpdump(1); curl(1) from curl.se. Left out: tools whose man page Apple does not publish as open source (networksetup, diskutil, log, softwareupdate, system_profiler, sw_vers…) and the launchctl subcommands newer than the published launchd man page. Commands that need root are listed as is: prefix them with sudo when needed.",
  "label": "macOS",
  "stopDebug": [],
  "stopKeys": "\u0003",
  "lists": [
    {
      "id": "system",
      "name": "System",
      "icon": "system",
      "color": "#5B4FC4",
      "summary": "Host, memory, disks, kernel messages and logins",
      "sections": [
        {
          "title": "Host",
          "items": [
            {
              "kind": "command",
              "cmd": "uname -a",
              "desc": "Kernel name, release and architecture"
            },
            {
              "kind": "command",
              "cmd": "hostinfo",
              "desc": "Mach kernel version, processors and memory"
            },
            {
              "kind": "command",
              "cmd": "uptime",
              "desc": "Uptime and load average"
            },
            {
              "kind": "command",
              "cmd": "sysctl kern.osversion",
              "desc": "macOS build number"
            },
            {
              "kind": "command",
              "cmd": "scutil --get ComputerName",
              "desc": "Computer name shown to users"
            },
            {
              "kind": "command",
              "cmd": "scutil --get LocalHostName",
              "desc": "Bonjour (.local) host name"
            }
          ]
        },
        {
          "title": "Memory & disks",
          "items": [
            {
              "kind": "command",
              "cmd": "sysctl hw.memsize hw.physicalcpu hw.logicalcpu",
              "desc": "Memory size and CPU cores"
            },
            {
              "kind": "command",
              "cmd": "vm_stat",
              "desc": "Virtual memory statistics (in pages)"
            },
            {
              "kind": "command",
              "cmd": "vm_stat -c 5 1",
              "desc": "Memory changes every second, 5 times"
            },
            {
              "kind": "command",
              "cmd": "sysctl vm.swapusage",
              "desc": "Swap usage"
            },
            {
              "kind": "command",
              "cmd": "df -h",
              "desc": "Disk space per filesystem"
            },
            {
              "kind": "command",
              "cmd": "du -h -d 1 <dir>",
              "desc": "Size of each folder inside a directory"
            },
            {
              "kind": "command",
              "cmd": "iostat -c 5 -w 1",
              "desc": "Disk and CPU activity every second, 5 times"
            }
          ]
        },
        {
          "title": "Kernel & logins",
          "items": [
            {
              "kind": "command",
              "cmd": "dmesg",
              "desc": "Kernel message buffer (needs root)"
            },
            {
              "kind": "command",
              "cmd": "who",
              "desc": "Users logged in"
            },
            {
              "kind": "command",
              "cmd": "w",
              "desc": "Users logged in and what they run"
            },
            {
              "kind": "command",
              "cmd": "last -n 20",
              "desc": "Last 20 logins"
            }
          ]
        }
      ]
    },
    {
      "id": "processes",
      "name": "Processes",
      "icon": "logs",
      "color": "#2E7D6B",
      "summary": "Processes and launchd jobs",
      "sections": [
        {
          "title": "Processes",
          "items": [
            {
              "kind": "command",
              "cmd": "ps aux",
              "desc": "Every process"
            },
            {
              "kind": "command",
              "cmd": "ps -Ao pid,user,%cpu,%mem,comm -r",
              "desc": "Processes, most CPU first"
            },
            {
              "kind": "command",
              "cmd": "ps -Ao pid,user,%cpu,%mem,comm -m",
              "desc": "Processes, most memory first"
            },
            {
              "kind": "command",
              "cmd": "top -l 1 -o cpu -n 15",
              "desc": "One snapshot of the 15 busiest processes"
            },
            {
              "kind": "command",
              "cmd": "top -o mem",
              "desc": "Live view sorted by memory (q to quit)"
            },
            {
              "kind": "command",
              "cmd": "kill <pid>",
              "desc": "Ask a process to stop (SIGTERM)",
              "action": true
            },
            {
              "kind": "command",
              "cmd": "killall <name>",
              "desc": "Stop every process with that name",
              "action": true
            }
          ]
        },
        {
          "title": "launchd",
          "items": [
            {
              "kind": "command",
              "cmd": "launchctl list",
              "desc": "Jobs loaded in launchd: PID, last exit status, label"
            },
            {
              "kind": "command",
              "cmd": "launchctl list <label>",
              "desc": "Details of one job"
            }
          ]
        }
      ]
    },
    {
      "id": "network",
      "name": "Network",
      "icon": "interfaces",
      "color": "#2F7A8C",
      "summary": "Interfaces, neighbors, DNS and sockets",
      "sections": [
        {
          "title": "Interfaces",
          "items": [
            {
              "kind": "command",
              "cmd": "ifconfig -l",
              "desc": "Names of every interface"
            },
            {
              "kind": "command",
              "cmd": "ifconfig <iface>",
              "desc": "Addresses and state of one interface"
            },
            {
              "kind": "command",
              "cmd": "netstat -i",
              "desc": "Packet and error counters per interface"
            }
          ]
        },
        {
          "title": "Neighbors & DNS",
          "items": [
            {
              "kind": "command",
              "cmd": "arp -an",
              "desc": "ARP table"
            },
            {
              "kind": "command",
              "cmd": "ndp -an",
              "desc": "IPv6 neighbor table"
            },
            {
              "kind": "command",
              "cmd": "scutil --dns",
              "desc": "DNS resolvers in use, per domain and interface"
            },
            {
              "kind": "command",
              "cmd": "scutil --proxy",
              "desc": "Proxy configuration"
            }
          ]
        },
        {
          "title": "Sockets",
          "items": [
            {
              "kind": "command",
              "cmd": "lsof -iTCP -sTCP:LISTEN -P -n",
              "desc": "Listening TCP ports and their processes"
            },
            {
              "kind": "command",
              "cmd": "lsof -i :<port>",
              "desc": "Who uses a port"
            },
            {
              "kind": "command",
              "cmd": "netstat -an -p tcp",
              "desc": "All TCP sockets"
            },
            {
              "kind": "command",
              "cmd": "netstat -s -p tcp",
              "desc": "TCP statistics"
            }
          ]
        }
      ]
    },
    {
      "id": "routing",
      "name": "Routing",
      "icon": "routing",
      "color": "#B26A1E",
      "summary": "Routing tables and route lookups",
      "sections": [
        {
          "title": "Routing",
          "items": [
            {
              "kind": "command",
              "cmd": "netstat -rn -f inet",
              "desc": "IPv4 routing table"
            },
            {
              "kind": "command",
              "cmd": "netstat -rn -f inet6",
              "desc": "IPv6 routing table"
            },
            {
              "kind": "command",
              "cmd": "route -n get default",
              "desc": "Default route and its interface"
            },
            {
              "kind": "command",
              "cmd": "route -n get <ip>",
              "desc": "Route used for a destination"
            }
          ]
        }
      ]
    },
    {
      "id": "diagnostics",
      "name": "Diagnostics",
      "icon": "sdwan",
      "color": "#3E6FC2",
      "summary": "Reachability, path, DNS-SD and HTTP checks",
      "sections": [
        {
          "title": "Reachability",
          "items": [
            {
              "kind": "command",
              "cmd": "ping -c 4 <host>",
              "desc": "Four pings to a host"
            },
            {
              "kind": "command",
              "cmd": "traceroute -n <host>",
              "desc": "Path to a host"
            },
            {
              "kind": "command",
              "cmd": "scutil -r <host>",
              "desc": "Whether the network configuration can reach a host"
            }
          ]
        },
        {
          "title": "DNS-SD & HTTP",
          "items": [
            {
              "kind": "command",
              "cmd": "dns-sd -G v4v6 <host>",
              "desc": "Resolve a name through mDNSResponder (Ctrl+C stops)"
            },
            {
              "kind": "command",
              "cmd": "dns-sd -B _ssh._tcp",
              "desc": "Browse SSH services announced on the network (Ctrl+C stops)"
            },
            {
              "kind": "command",
              "cmd": "curl -v <url>",
              "desc": "Request with headers and TLS details"
            },
            {
              "kind": "command",
              "cmd": "curl -I <url>",
              "desc": "Response headers only"
            }
          ]
        }
      ]
    },
    {
      "id": "power",
      "name": "Power",
      "icon": "ha",
      "color": "#C08A1E",
      "summary": "Power settings, battery and sleep assertions",
      "sections": [
        {
          "title": "Power",
          "items": [
            {
              "kind": "command",
              "cmd": "pmset -g",
              "desc": "Power settings in use"
            },
            {
              "kind": "command",
              "cmd": "pmset -g batt",
              "desc": "Battery and UPS status"
            },
            {
              "kind": "command",
              "cmd": "pmset -g assertions",
              "desc": "What is preventing sleep"
            },
            {
              "kind": "command",
              "cmd": "pmset -g sched",
              "desc": "Scheduled wake and sleep events"
            },
            {
              "kind": "command",
              "cmd": "caffeinate -d",
              "desc": "Keep the display awake until Ctrl+C"
            },
            {
              "kind": "command",
              "cmd": "caffeinate -i -t <seconds>",
              "desc": "Prevent idle sleep for a number of seconds"
            }
          ]
        }
      ]
    },
    {
      "id": "capture",
      "name": "Capture",
      "icon": "debug",
      "color": "#B23B3B",
      "summary": "tcpdump — Ctrl+C or \"Stop debug\" ends it",
      "sections": [
        {
          "title": "tcpdump",
          "items": [
            {
              "kind": "command",
              "cmd": "tcpdump -D",
              "desc": "Interfaces tcpdump can capture on"
            },
            {
              "kind": "command",
              "cmd": "tcpdump -n -i <iface>",
              "desc": "Capture on an interface, no name lookups"
            },
            {
              "kind": "command",
              "cmd": "tcpdump -n -i <iface> host <ip>",
              "desc": "Only traffic to or from a host"
            },
            {
              "kind": "command",
              "cmd": "tcpdump -n -i <iface> port <port>",
              "desc": "Only traffic on a port"
            },
            {
              "kind": "command",
              "cmd": "tcpdump -n -k -i pktap,all",
              "desc": "All interfaces, with Apple packet metadata (interface, process…)"
            },
            {
              "kind": "command",
              "cmd": "tcpdump -n -i <iface> -w <file>",
              "desc": "Save the capture to a pcap file"
            }
          ]
        }
      ]
    }
  ]
}
