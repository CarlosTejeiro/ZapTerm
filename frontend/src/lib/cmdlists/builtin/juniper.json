              "cmd": "show ospf interface",
              "desc": "Interfaces running OSPF"
            },
            {
              "kind": "command",
              "cmd": "show ospf database",
              "desc": "OSPF link-state database"
            },
            {
              "kind": "command",
              "cmd": "show ospf3 neighbor",
              "desc": "OSPFv3 neighbors (IPv6)"
            }
          ]
        },
        {
          "title": "IS-IS",
          "items": [
            {
              "kind": "command",
              "cmd": "show isis adjacency",
              "desc": "IS-IS adjacencies"
            },
            {
              "kind": "command",
              "cmd": "show isis database",
              "desc": "IS-IS link-state database"
            }
          ]
        }
      ]
    },
    {
      "id": "mpls",
      "name": "MPLS",
      "icon": "vpn",
      "color": "#1F7A55",
      "summary": "LSPs, LDP and RSVP",
      "sections": [
        {
          "title": "MPLS",
          "items": [
            {
              "kind": "command",
              "cmd": "show mpls lsp",
              "desc": "MPLS LSPs and their state"
            },
            {
              "kind": "command",
              "cmd": "show ldp neighbor",
              "desc": "LDP neighbors"
            },
            {
              "kind": "command",
              "cmd": "show ldp session",
              "desc": "LDP sessions"
            },
            {
              "kind": "command",
              "cmd": "show rsvp session",
              "desc": "RSVP sessions"
            }
          ]
        }
      ]
    },
    {
      "id": "security",
      "name": "Security",
      "icon": "security",
      "color": "#A23B72",
      "summary": "SRX zones, policies, sessions, IPsec and firewall filters",
      "sections": [
        {
          "title": "SRX",
          "items": [
            {
              "kind": "command",
              "cmd": "show security zones",
              "desc": "Security zones and their interfaces"
            },
            {
              "kind": "command",
              "cmd": "show security policies hit-count",
              "desc": "Policy hit counters"
            },
            {
              "kind": "command",
              "cmd": "show security flow session summary",
              "desc": "Session counts"
            },
            {
              "kind": "command",
              "cmd": "show security flow session destination-prefix <ip>",
              "desc": "Sessions to a destination"
            },
            {
              "kind": "command",
              "cmd": "show security ike security-associations",
              "desc": "IKE security associations"
            },
            {
              "kind": "command",
              "cmd": "show security ipsec security-associations",
              "desc": "IPsec security associations"
            }
