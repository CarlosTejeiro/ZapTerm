        },
        {
          "title": "Firewall filters",
          "items": [
            {
              "kind": "command",
              "cmd": "show firewall",
              "desc": "Firewall filter counters"
            }
          ]
        }
      ]
    },
    {
      "id": "monitor",
      "name": "Monitor",
      "icon": "debug",
      "color": "#B23B3B",
      "summary": "Live capture and log follow — \"Stop debug\" ends them",
      "debug": true,
      "sections": [
        {
          "title": "Live output",
          "items": [
            {
              "kind": "command",
              "cmd": "monitor traffic interface <interface> no-resolve",
              "desc": "Packet headers on an interface"
            },
            {
              "kind": "command",
              "cmd": "monitor start messages",
              "desc": "Follow the messages log in this session"
            },
            {
              "kind": "command",
              "cmd": "monitor stop",
              "desc": "Stop following logs"
            }
          ]
        }
      ]
    }
  ]
}
