{
  "format": "zapterm-command-lists",
  "version": 1,
  "platform": "windows",
  "notes": "Windows (PowerShell) command lists. Also shown for local tabs on Windows, which run PowerShell (pwsh when installed, else Windows PowerShell). Every command below was checked against Microsoft's documentation on learn.microsoft.com — nothing was added from memory: the PowerShell module references (Microsoft.PowerShell.Management/Utility/Core/Diagnostics, Storage, CimCmdlets, NetTCPIP, NetAdapter, NetConnection, DnsClient, NetSecurity, Hyper-V), the Windows Commands reference (systeminfo, ipconfig, ping, tracert, pathping), \"Basic commands for WSL\" and \"Creating Get-WinEvent queries with FilterHashtable\" (Level 2 = Error). Get-Uptime needs PowerShell 6 or later. The Hyper-V cmdlets need the Hyper-V module and an elevated session; Measure-VM needs resource metering enabled on the VM.",
  "label": "Windows · PowerShell",
  "stopDebug": [],
  "lists": [
    {
      "id": "system",
      "name": "System",
      "icon": "system",
      "color": "#5B4FC4",
      "summary": "OS, uptime, updates, disks, processes and services",
      "sections": [
        {
          "title": "System",
          "items": [
            {
              "kind": "command",
              "cmd": "systeminfo",
              "desc": "OS, build, boot time, memory and hotfixes"
            },
            {
              "kind": "command",
              "cmd": "Get-ComputerInfo",
              "desc": "Detailed system and OS properties"
            },
            {
              "kind": "command",
              "cmd": "Get-Uptime",
              "desc": "Time since the last boot (PowerShell 6+)"
            },
            {
              "kind": "command",
              "cmd": "Get-HotFix",
              "desc": "Installed updates"
            },
            {
              "kind": "command",
              "cmd": "Get-Volume",
              "desc": "Volumes, file systems and free space"
            }
          ]
        },
        {
          "title": "Processes & services",
          "items": [
            {
              "kind": "command",
              "cmd": "Get-Process | Sort-Object -Property CPU -Descending | Select-Object -First 15",
              "desc": "Top 15 processes by CPU time"
            },
            {
              "kind": "command",
              "cmd": "Get-Process -Name <name>",
              "desc": "One process by name"
            },
            {
              "kind": "command",
              "cmd": "Get-Service | Where-Object Status -EQ Running",
              "desc": "Running services"
            },
            {
              "kind": "command",
              "cmd": "Get-Service -Name <name>",
              "desc": "One service and its status"
            },
            {
              "kind": "command",
              "cmd": "Restart-Service -Name <name>",
              "desc": "Restart a service",
              "action": true
            }
          ]
        },
        {
          "title": "Administrator",
          "items": [
            {
              "kind": "command",
              "cmd": "Start-Process -FilePath \"powershell\" -Verb RunAs",
              "desc": "Open an elevated PowerShell in a new window (asks for admin credentials)"
            }
          ]
        }
      ]
    },
    {
