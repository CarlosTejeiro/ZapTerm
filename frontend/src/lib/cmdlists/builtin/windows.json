              "desc": "Flush the DNS client cache",
              "action": true
            }
          ]
        }
      ]
    },
    {
      "id": "diagnostics",
      "name": "Diagnostics",
      "icon": "sdwan",
      "color": "#3E6FC2",
      "summary": "Reachability, paths and TCP port tests",
      "sections": [
        {
          "title": "Reachability",
          "items": [
            {
              "kind": "command",
              "cmd": "ping /n 4 <host>",
              "desc": "Four pings to a host"
            },
            {
              "kind": "command",
              "cmd": "tracert /d <host>",
              "desc": "Path to a host, no name lookups"
            },
            {
              "kind": "command",
              "cmd": "pathping /n <host>",
              "desc": "Path with per-hop loss, no name lookups"
            },
            {
              "kind": "command",
              "cmd": "Test-NetConnection -ComputerName <host> -Port <port>",
              "desc": "Test a TCP port"
            },
            {
              "kind": "command",
              "cmd": "Test-NetConnection -ComputerName <host> -TraceRoute",
              "desc": "Ping plus traceroute"
            }
          ]
        }
      ]
    },
    {
