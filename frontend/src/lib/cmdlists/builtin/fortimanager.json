    {
      "id": "debug",
      "name": "Capture",
      "icon": "debug",
      "color": "#C2410C",
      "summary": "Packet capture, bounded in packets",
      "sections": [
        {
          "title": "Sniffer",
          "items": [
            {
              "kind": "recipe",
              "name": "Packet sniffer",
              "desc": "Capture packets on an interface with a filter (Ctrl+C to stop)",
              "fields": [
                {
                  "key": "iface",
                  "label": "Interface",
                  "default": "port1"
                },
                {
                  "key": "filter",
                  "label": "Filter",
                  "placeholder": "host 10.0.0.25"
                },
                {
                  "key": "verbose",
                  "label": "Verbose",
                  "default": "1",
                  "min": 1,
                  "max": 3
                },
                {
                  "key": "count",
                  "label": "Packets",
                  "default": "100",
                  "min": 1,
                  "max": 1000
                }
              ],
              "lines": ["diagnose sniffer packet {{iface}} '{{filter}}' {{verbose}} {{count}} l"],
              "caution": "Fortinet: “Packet capture can be very resource intensive” and should be used “only during periods of minimal traffic”. Keep a filter and a small count; Ctrl+C stops it."
            }
          ]
        }
      ],
      "debug": true
    }
  ]
}
